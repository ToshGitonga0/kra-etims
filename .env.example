# Copy this file to .env and fill in real values for local development.
# NEVER commit .env. See SECURITY.md.

# Which KRA server tier to target. Only used by examples/scripts, not by the
# library itself (pass `environment` explicitly when constructing EtimsClient).
ETIMS_ENVIRONMENT=sandbox

# Taxpayer PIN (KRA "tin"). Use a sandbox test PIN, never a production PIN,
# outside of production deployments.
ETIMS_PIN=A123456789Z

# Branch office ID. "00" = head office.
ETIMS_BRANCH_ID=00

# Communication key issued by KRA after device initialization
# (oscu.init.initialize(...) -> data.cmcKey). Leave blank until you have run
# device initialization once against the sandbox.
ETIMS_CMC_KEY=

# Device serial number you choose when calling oscu.init.initialize(...).
ETIMS_DEVICE_SERIAL=dev-serial-0001

# Set to "true" to allow tests/integration/* to make real network calls to
# the KRA sandbox. Never set this in CI without sandbox-only credentials.
KRA_ETIMS_RUN_INTEGRATION=false

# For VSCU mode only: base URL of your locally running VSCU instance.
# VSCU_BASE_URL=http://localhost:8088
